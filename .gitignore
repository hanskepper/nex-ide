# ==========================================
# NEX IDE - .gitignore
# ==========================================

# 🔐 Environment variables and secrets (CRITICAL)
.env
.env.*
!.env.example
*.pem
*.key
secrets/
*secret*
*credentials*

# 🏗️ Gradle files
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
.kotlin/

# ⚙️ Local configuration file (sdk path, etc)
local.properties

# 🐙 Node.js (For the backend)
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log
pnpm-debug.log
dist/
build/
.next/
coverage/

# 📱 Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json
*.hprof

# 💻 IntelliJ & IDE files
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml
*.swp
*~

# 🔑 Keystore files (Signatures)
*.jks
*.keystore
keystore.properties

# 🔥 Google Services (e.g. APIs or Firebase)
google-services.json

# 📦 Temporary and OS files
*.log
.DS_Store
Thumbs.db
tmp/
temp/

# 🐳 Docker
docker-compose.override.yml 
