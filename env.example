# ==========================================
# NEX IDE - Environment Variables Template
# ==========================================
# Copy this file to .env and fill in the actual values.
# NEVER commit the .env file to version control.

# ------------------------------------------------------------
# 🗄️ SUPABASE (Database, Auth, Storage)
# ------------------------------------------------------------
# Retrieve from: Supabase Dashboard > Settings > API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# Supabase Storage Buckets (to be created)
SUPABASE_BUCKET_PROJECTS="nex-projects"
SUPABASE_BUCKET_ARTIFACTS="nex-artifacts"
SUPABASE_BUCKET_AVATARS="nex-avatars"

# ------------------------------------------------------------
# 🐙 GITHUB (Auth, Build, Repositories)
# ------------------------------------------------------------
# Retrieve from: GitHub > Settings > Developer settings > Personal access tokens
# Required scopes: repo, workflow, admin:repo_hook
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"
GITHUB_PERSONAL_ACCESS_TOKEN="ghp_your_personal_access_token"
GITHUB_WEBHOOK_SECRET="a-random-secret-for-webhooks"

# Temporary build repository (created by the API)
GITHUB_BUILD_REPO_OWNER="your-github-username"
GITHUB_BUILD_REPO_NAME="nex-build-temp"

# ------------------------------------------------------------
# 🔔 FIREBASE (Push Notifications via FCM)
# ------------------------------------------------------------
# Retrieve from: Firebase Console > Project Settings > Cloud Messaging
FCM_PROJECT_ID="your-firebase-project-id"
FCM_PRIVATE_KEY_ID="your-private-key-id"
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FCM_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FCM_CLIENT_ID="your-client-id"
FCM_AUTH_URI="https://accounts.google.com/o/oauth2/auth"
FCM_TOKEN_URI="https://oauth2.googleapis.com/token"

# ------------------------------------------------------------
# 🧠 LSP SERVERS (Language Server Protocol)
# ------------------------------------------------------------
# WebSocket URLs for LSP servers (to be deployed via Docker)
LSP_JAVA_WS_URL="ws://localhost:30003/java"
LSP_KOTLIN_WS_URL="ws://localhost:30004/kotlin"
LSP_XML_WS_URL="ws://localhost:30005/xml"

# Timeouts (in milliseconds)
LSP_CONNECTION_TIMEOUT=10000
LSP_REQUEST_TIMEOUT=5000

# ------------------------------------------------------------
# 🏗️ BUILD ENGINE (GitHub Actions or alternative)
# ------------------------------------------------------------
# Provider type: "github" or "codemagic"
BUILD_PROVIDER="github"

# GitHub Actions workflow to trigger
BUILD_WORKFLOW_FILE="android-build.yml"
BUILD_WORKFLOW_REF="main"

# Alternative: Codemagic
CODEMAGIC_API_KEY="your-codemagic-api-key"
CODEMAGIC_APP_ID="your-codemagic-app-id"

# Build limits
BUILD_MAX_DURATION_MINUTES=30
BUILD_MAX_CONCURRENT_PER_USER=2

# ------------------------------------------------------------
# 🔐 SECURITY & ENCRYPTION
# ------------------------------------------------------------
# Encryption key for secrets in database (min 32 characters)
ENCRYPTION_KEY="a-very-long-and-random-encryption-key-32-chars-min"

# Secret for signing session JWT (if not using Supabase Auth)
JWT_SECRET="another-very-long-secret-for-sessions"

# Token expiration times (in seconds)
ACCESS_TOKEN_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=604800

# ------------------------------------------------------------
# 🌐 API & BACKEND
# ------------------------------------------------------------
# Backend server port
PORT=3000
NODE_ENV="development"

# API URL (for calls from the Android app)
API_BASE_URL="http://10.0.2.2:3000/api/v1"
# Note: 10.0.2.2 is the host address as seen from the Android emulator

# Frontend URL (if you have a PWA or web dashboard)
FRONTEND_URL="http://localhost:5173"

# CORS (allowed origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# ------------------------------------------------------------
# 📊 MONITORING & LOGS
# ------------------------------------------------------------
# Sentry (optional)
SENTRY_DSN="https://xxxxx@o0.ingest.sentry.io/0"
SENTRY_ENVIRONMENT="development"

# Log level: "debug", "info", "warn", "error"
LOG_LEVEL="debug"

# ------------------------------------------------------------
# ⚡ RATE LIMITING & QUOTAS
# ------------------------------------------------------------
# Maximum requests per minute per user
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_MS=60000

# Storage quotas (in MB)
STORAGE_QUOTA_MB=500
BUILD_QUOTA_PER_DAY=10

# ------------------------------------------------------------
# 🐳 DOCKER & HOSTING (Self-hosting)
# ------------------------------------------------------------
# Docker network for LSP containers
DOCKER_NETWORK="nex-ide-network"

# Ports exposed by containers
LSP_JAVA_PORT=30003
LSP_KOTLIN_PORT=30004
LSP_XML_PORT=30005

# ------------------------------------------------------------
# 🌍 INTERNATIONALIZATION
# ------------------------------------------------------------
# Supported languages (comma-separated)
SUPPORTED_LANGUAGES="en,fr"
DEFAULT_LANGUAGE="en"

# ------------------------------------------------------------
# 🧪 TEST ENVIRONMENT
# ------------------------------------------------------------
# Test database (optional)
TEST_SUPABASE_URL="https://your-test-project.supabase.co"
TEST_SUPABASE_ANON_KEY="your-test-anon-key"

# Test GitHub token (optional)
TEST_GITHUB_TOKEN="ghp_your_test_github_token"